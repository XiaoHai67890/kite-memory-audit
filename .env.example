# Paid mode never needs a private key. PAY_TO is a public receiving address.
AUDIT_MODE=paid
HOST=127.0.0.1
PORT=8080
KITE_NETWORK=testnet
PAY_TO=
PRICE_USD=0.001
PUBLIC_BASE_URL=http://127.0.0.1:8080
REGISTRIES_FILE=config/registries.json
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAX_CONCURRENT_AUDITS=2
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
# For localhost-only, unpaid development set AUDIT_MODE=local.
# The app does not implicitly load .env: use Node --env-file=.env.
